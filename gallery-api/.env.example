# Server
PORT=8787
CORS_ORIGIN=http://localhost:3000,https://eise.app

# Admin Basic Auth
ADMIN_USER=admin
ADMIN_PASS=change-me

# Bunny Database (libSQL). If empty, falls back to local ./gallery.db
BUNNY_DATABASE_URL=
BUNNY_DATABASE_AUTH_TOKEN=

# Bunny Storage. If empty, falls back to local ./uploads served at /files
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_PUBLIC_URL=

# Limits
MAX_IMAGE_BYTES=20971520
