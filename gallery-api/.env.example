# Server
PORT=8787
CORS_ORIGIN=http://localhost:3000,https://eise.app

# Admin Basic Auth
ADMIN_USER=admin
ADMIN_PASS=change-me

# Bunny Database (libSQL). If empty, falls back to local ./gallery.db
BUNNY_DATABASE_URL=
BUNNY_DATABASE_AUTH_TOKEN=

# Bunny Storage. If empty, falls back to local ./uploads served at /files
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com
BUNNY_STORAGE_PUBLIC_URL=

# Limits
MAX_IMAGE_BYTES=20971520

# Analytics (separate Bunny Database from the gallery DB)
# If ANALYTICS_DB_URL is empty, the /a/* endpoints are not mounted.
ANALYTICS_DB_URL=
ANALYTICS_DB_TOKEN=
# Random secret (>=32 chars). Used to salt the daily visitor_hash and to
# HMAC-sign the admin role cookie. Rotate carefully: rotating invalidates all
# existing admin role cookies and breaks daily-unique dedup for the day.
ANALYTICS_SALT=
# Cookie Domain for the admin role cookie. Empty in dev (localhost).
# In prod use a leading-dot form so it's shared across subdomains, e.g. .eise.app
ADMIN_COOKIE_DOMAIN=
